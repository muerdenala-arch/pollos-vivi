# Copiar como ".env" y completar con valores reales.
# En Vercel: Project Settings → Environment Variables (no subir el .env real al repo).

# --- Neon PostgreSQL ---
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/neondb?sslmode=require

# --- Cloudinary (comprobantes de pago y QR) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- JWT (sesión de usuarios) ---
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_SEGURA_DE_64_CHARS
