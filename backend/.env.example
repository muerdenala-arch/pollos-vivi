# Configuración del Entorno — Sistema POS
# Copiar este archivo como .env y completar los valores reales

# --- Base de Datos ---
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/pos_pollo

# --- Seguridad JWT ---
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_SEGURA_DE_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Archivos Subidos (Comprobantes) ---
UPLOAD_DIR=./uploads

# --- Configuración de la App ---
APP_NAME="Sistema POS - Pollo & Salchipapas"
DEBUG=True

# --- QR Estático (imagen subida por el administrador) ---
# Ruta relativa a la imagen del QR de pago (Yape/Plin/BCP)
STATIC_QR_PATH=./uploads/qr_pago.png
